<title>CORPOELEC_AI_STUDIO_DESIGN_SYSTEM_PROMPT</title>
<style>
@page {
  size: letter portrait;
  margin: 1.0in;
}
body {
  font-family: Calibri, Arial, sans-serif;
  margin: 0;
  padding: 0;
  background-color: #FFFFFF;
}
