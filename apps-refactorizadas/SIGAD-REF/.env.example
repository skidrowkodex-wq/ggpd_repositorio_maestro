# ==============================================================================
# SIGAD — Variables de entorno (plantilla; NO incluye secretos)
# Copia este archivo a `.env` y completa los valores reales.
# ==============================================================================

# --- InsForge Cloud (backend usado cuando la app corre desplegada / en la nube) ---
VITE_INSFORGE_URL=https://wxkeqf37.ap-southeast.insforge.app
VITE_INSFORGE_API_KEY=ik_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- PostgreSQL Local (backend usado cuando la app corre en localhost, sin internet) ---
# Puente REST local: `python scripts/local_pg_bridge.py` (por defecto 127.0.0.1:5431)
VITE_LOCAL_API_URL=http://127.0.0.1:5431
VITE_LOCAL_API_KEY=local-bridge

# Vacío = automático (localhost -> local, cualquier otro host -> InsForge).
# Forzar backend con: local | insforge
VITE_DATA_BACKEND=
