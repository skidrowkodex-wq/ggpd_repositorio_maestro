{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/health", "dest": "/api/index" },
    { "src": "/api/ai/(.*)", "dest": "/api/index" },
    { "src": "/api/login/firebase", "dest": "/api/index" },
    { "src": "/api/login", "dest": "/api/index" },
    { "src": "/api/logout", "dest": "/api/index" },
    { "src": "/api/me", "dest": "/api/index" },
    { "src": "/api/interrupciones", "dest": "/api/index" },
    { "src": "/api/interrupciones/(.*)", "dest": "/api/index" },
    { "src": "/api/causas", "dest": "/api/index" },
    { "src": "/api/sub_causas", "dest": "/api/index" },
    { "src": "/api/despachadores", "dest": "/api/index" },
    { "src": "/api/estados", "dest": "/api/index" },
    { "src": "/api/subestaciones", "dest": "/api/index" },
    { "src": "/api/circuitos", "dest": "/api/index" },
    { "src": "/api/importar/preview", "dest": "/api/index" },
    { "src": "/api/importar/confirmar", "dest": "/api/index" },
    { "src": "/api/importar/limpiar", "dest": "/api/index" },
    { "src": "/api/admin/usuarios", "dest": "/api/index" },
    { "src": "/api/descargar-formulario", "dest": "/api/index" },
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "src": "/(.*)", "dest": "/api/index" }
  ],
  "env": {
    "DB_HOST": "@db_host",
    "DB_PORT": "@db_port",
    "DB_NAME": "@db_name",
    "DB_USER": "@db_user",
    "DB_PASSWORD": "@db_password",
    "DB_SSLMODE": "@db_sslmode",
    "DB_SCHEMA": "@db_schema",
    "APP_SECRET": "@app_secret",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "PORT": "8080",
    "GEMINI_API_KEY": "@gemini_api_key",
    "GEMINI_MODEL": "gemini-2.5-flash",
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_ANON_KEY": "@supabase_anon_key",
    "SUPABASE_SERVICE_KEY": "@supabase_service_key",
    "FIREBASE_PROJECT_ID": "@firebase_project_id",
    "FIREBASE_CLIENT_EMAIL": "@firebase_client_email",
    "FIREBASE_PRIVATE_KEY": "@firebase_private_key",
    "REGION": "us-central1",
    "LOG_LEVEL": "INFO"
  }
}