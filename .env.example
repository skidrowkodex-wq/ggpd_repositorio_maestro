# -----------------------------------------------------------------------------
# GITHUB TOKENS (para push a repositorios privados)
# -----------------------------------------------------------------------------
GITHUB_TOKEN_PERSONAL=tu_github_token_personal_aqui
GITHUB_TOKEN_INNOVACION=tu_github_token_innovacion_aqui

# -----------------------------------------------------------------------------
# PUERTOS DE LAS APLICACIONES REFACTORIZADAS (apps-refactorizadas/)
# -----------------------------------------------------------------------------
# SIGI-REF (Consola Central)        → Puerto 3001
# SCTIS-REF (Tiras Interrupción)    → Puerto 3002
# SCMTP-REF (Minutas y Tareas)      → Puerto 3003
# SCPPE-REF (Planificación Eléctrica) → Puerto 3004
# SCEIN-REF (Equipos Indisponibles) → Puerto 3005
# SCGCC-REF (Correspondencia)       → Puerto 3006

# -----------------------------------------------------------------------------
# ESQUEMAS DE BASE DE DATOS POR APLICACIÓN (InsForge PostgreSQL)
# -----------------------------------------------------------------------------
# core.*          → Núcleo maestro transversal (regiones, estados, usuarios, SEs, circuitos)
# sigi.*          → Consola central de gestión
# scmtp.*         → Minutas y tareas operativas
# scppe.*         → Planificación SEN, viáticos, PRTSEN
# scein.*         → Equipos indisponibles de subestaciones
# sctis.*         → Tiras de interrupción de distribución
# scgcc.*         → Correspondencia corporativa
# knowledge.*     → BCI (Base de Conocimientos Inteligente)

# =============================================================================
# NOTAS DE CONFIGURACIÓN POR APLICACIÓN
# =============================================================================
#
# SIGI-REF (apps-refactorizadas/SIGI-REF/):
#   - Requiere: VITE_INSFORGE_URL, VITE_INSFORGE_API_KEY
#   - Opcional: VITE_BCI_URL, VITE_BCI_API_KEY (para módulo BCI Governance)
#
# SCTIS-REF (apps-refactorizadas/SCTIS-REF/):
#   - Requiere: INSFORGE_URL, INSFORGE_API_KEY, INSFORGE_PROJECT_ID, DB_SCHEMA=sctis
#   - Es una app Python/Flask (no Node.js)
#
# SCMTP-REF (apps-refactorizadas/SCMTP-REF/):
#   - Requiere: VITE_INSFORGE_URL, VITE_INSFORGE_API_KEY, INSFORGE_URL, INSFORGE_API_KEY
#   - Build: npm run build (Vite + esbuild para server.cjs)
#
# SCPPE-REF (apps-refactorizadas/SCPPE-REF/):
#   - Requiere: VITE_INSFORGE_URL, VITE_INSFORGE_API_KEY, INSFORGE_URL, INSFORGE_API_KEY
#   - Build: npm run build (Vite)
#
# SCEIN-REF (apps-refactorizadas/SCEIN-REF/):
#   - Requiere: INSFORGE_URL, INSFORGE_API_KEY, VITE_INSFORGE_URL, VITE_INSFORGE_API_KEY
#   - Build: npm run build (Vite + esbuild para server.cjs)
#   - Tabla principal: scein.equipment_records (creada vía SQL en InsForge)
#
# SCGCC-REF (apps-refactorizadas/SCGCC-REF/):
#   - Requiere: VITE_INSFORGE_URL, VITE_INSFORGE_API_KEY, INSFORGE_URL, INSFORGE_API_KEY
#   - Build: npm run build (Vite + esbuild para server.cjs)
#
# PORTAL MAESTRO (raíz del repo):
#   - npm run dev (Vite en puerto 5173)
#   - npm run serve:portal (Python HTTP server en puerto 5000)
#
