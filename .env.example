INSFORGE_PROJECT_ID=c18a2d35-e199-490d-9827-939d4d757c53

# Variables VITE (expuestas al cliente/browser)
VITE_INSFORGE_URL=https://wxkeqf37.ap-southeast.insforge.app
VITE_INSFORGE_API_KEY=tu_api_key_insforge_aqui

# -----------------------------------------------------------------------------
# INS FORGE BCI (Base de Conocimientos Inteligente — instancia separada)
